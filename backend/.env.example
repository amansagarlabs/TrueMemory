# Backend-only environment. Copy to backend/.env for local backend runs.
# Never commit real secrets.
APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_VISION_MODEL=openrouter/free
OPENROUTER_MAX_TOKENS=2048

# Supabase PostgreSQL. Use the Session Pooler URL for hosted deployments.
DATABASE_URL=postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres
USE_DOCKER_POSTGRES=false

# Durable uploaded binaries (server-side only; never expose the API secret).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=truememory

MILVUS_ADDRESS=
MILVUS_TOKEN=
MILVUS_COLLECTION_NAME=pdf_chunks

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/oauth/google/callback
GOOGLE_OAUTH_FRONTEND_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/oauth/github/callback
GITHUB_OAUTH_FRONTEND_URL=http://localhost:3000

CORS_ORIGINS=http://localhost:3000
AUTH_COOKIE_SECURE=false
AMAN_JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAILS=
