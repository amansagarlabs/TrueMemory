# =============================================================================
# AI PDF Learning Workspace — Environment Variables
# Location: D:\aman\18-may-personal\my-ai-app\.env
# Copy:  copy .env.example .env   (run from my-ai-app folder)
# =============================================================================

# --- OpenRouter (LLM) — Step 9 ---
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=openrouter/free
# Vision-capable fallback used whenever an attached image is sent to a text-only selection.
OPENROUTER_VISION_MODEL=openrouter/free
# Keep completion requests affordable on low-credit accounts.
OPENROUTER_MAX_TOKENS=2048
# OpenRouter image model used by the composer image action.
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
OPENROUTER_SITE_URL=http://localhost:3000
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3-coder:30b
OLLAMA_FALLBACK_ENABLED=true
# Free browser generation through Puter.js by default. Set to openrouter only
# when the server account has image credits.
NEXT_PUBLIC_IMAGE_GENERATOR=puter
NEXT_PUBLIC_PUTER_IMAGE_MODEL=black-forest-labs/flux-2-klein-4b

# --- Zilliz Cloud (Managed Milvus) — Step 7 ---
# Public endpoint from Zilliz dashboard (include https:// and :443)
MILVUS_ADDRESS=https://in03-xxxxxx.api.gcp-us-west1.zillizcloud.com:443
# Token format: "<db_username>:<db_password>" OR your API key from dashboard
MILVUS_TOKEN=your_zilliz_token_here
MILVUS_COLLECTION_NAME=pdf_chunks

# --- Embeddings — Step 6 ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# --- RAG / Chunking — Steps 4–5 ---
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_CHUNKS=5
PIPELINE_MAX_CHUNKS=120

# --- Curated knowledge-base retrieval ---
CURATED_KB_PATH=knowledge_base/curated.jsonl
HYBRID_DENSE_WEIGHT=0.55
HYBRID_BM25_WEIGHT=0.45
HYBRID_CANDIDATE_K=24
HYBRID_TOP_K=6
# Optional; blank disables cross-encoder reranking.
CROSS_ENCODER_MODEL=
WARM_RETRIEVAL_MODELS=false

# --- Automatic web search fallback ---
WEB_SEARCH_ENABLED=false
TAVILY_API_KEY=
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/integrations/github/callback
GITHUB_OAUTH_FRONTEND_URL=http://localhost:3000/connectors
GITHUB_OAUTH_SCOPE=read:user user:email
# Comma-separated server-side admin allowlist. Empty means no admin access.
ADMIN_USER_IDS=
ADMIN_EMAILS=
WEB_SEARCH_MAX_RESULTS=5
# Credential-free search defaults. Run `docker compose --profile search up -d searxng`
# for a local SearXNG instance; remote fallback is opt-in.
SEARXNG_URL=http://searxng:8080
SEARCH_ALLOW_REMOTE_FALLBACK=true
SEARCH_FREE_ONLY=true
SEARCH_FREE_ONLY=true
SEARCH_ALLOW_REMOTE_FALLBACK=false
IMAGE_SEARCH_ENABLED=true
IMAGE_SEARCH_MAX_RESULTS=5
IMAGE_SEARCH_TIMEOUT=8
OPENVERSE_ENABLED=true
WIKIMEDIA_ENABLED=true

# --- Backend server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000
# Enable for HTTPS production deployments.
AUTH_COOKIE_SECURE=false
# Local backend path. Docker Compose overrides this with /app/data/memory.db.
MEMORY_DB_PATH=backend/data/memory.db
MEMORY_RECENT_TURNS=8
MEMORY_PROFILE_ITEMS=6
MEMORY_HOT_TTL_SECONDS=30
MEMORY_HOT_MAX_ENTRIES=512
MEMORY_L2_CANDIDATE_LIMIT=200
MEMORY_L2_RRF_K=60
MEMORY_L2_SEMANTIC_ENABLED=true
MEMORY_L2_EMBEDDING_RETRY_SECONDS=30

# --- Image OCR ---
# auto uses PaddleOCR-VL when its optional runtime is installed, then falls back
# to lightweight local Tesseract. Set paddleocr-vl to require the VLM provider.
OCR_PROVIDER=auto
OCR_LANGUAGE=eng
TESSERACT_CMD=
PADDLEOCR_DEVICE=cpu
PADDLEOCR_PIPELINE_VERSION=v1.6

# --- Local PostgreSQL (MVP app database) ---
USE_DOCKER_POSTGRES=false
POSTGRES_LOCAL_HOST=localhost
POSTGRES_DOCKER_HOST=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
PGADMIN_PORT=5050
POSTGRES_DB=app-agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL_LOCAL=postgresql://postgres:postgres@localhost:5432/app-agent
DATABASE_URL_DOCKER=postgresql://postgres:postgres@postgres:5432/app-agent
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app-agent

# --- Frontend (Next.js reads NEXT_PUBLIC_* only) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
# Free publishable token from https://www.logo.dev/ used for connector marks.
NEXT_PUBLIC_LOGO_DEV_PUBLISHABLE_KEY=
